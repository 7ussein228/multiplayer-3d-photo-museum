# PostgreSQL connection string used by Drizzle ORM.
# Local development:
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Set to "true" when the provider requires TLS but the URL has no sslmode.
# DATABASE_SSL=true

# Maximum pooled connections per instance. Defaults to 1 on Vercel, 10 elsewhere.
# DATABASE_POOL_MAX=5
